# Name participants see in the app header and screens
NEXT_PUBLIC_APP_NAME="Airport Parking"

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign participant cookies (openssl rand -hex 32)
STUDY_SIGNING_SECRET=

# Comma-separated emails allowed into /admin (in addition to the admin_users table)
ADMIN_EMAILS=

# Local development only: store data in ./.data instead of Supabase, and open /admin without login
STUDY_LOCAL_STORE=
